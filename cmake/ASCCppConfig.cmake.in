@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_ASCCpp_supported_components core utilities array linalg random cpp)
set(ASCCpp_FOUND TRUE)
set(_ASCCpp_needs_linalg FALSE)
if(NOT ASCCpp_FIND_COMPONENTS)
  set(_ASCCpp_needs_linalg TRUE)
endif()
foreach(_ASCCpp_requested IN LISTS ASCCpp_FIND_COMPONENTS)
  if(NOT _ASCCpp_requested IN_LIST _ASCCpp_supported_components)
    set(ASCCpp_${_ASCCpp_requested}_FOUND FALSE)
    set(ASCCpp_NOT_FOUND_MESSAGE
      "Unsupported ASCCpp component '${_ASCCpp_requested}'. Supported components: ${_ASCCpp_supported_components}."
    )
  else()
    set(ASCCpp_${_ASCCpp_requested}_FOUND TRUE)
  endif()
  if(_ASCCpp_requested STREQUAL "linalg" OR
     _ASCCpp_requested STREQUAL "cpp")
    set(_ASCCpp_needs_linalg TRUE)
  endif()
endforeach()
check_required_components(ASCCpp)
if(NOT ASCCpp_FOUND)
  return()
endif()

if(@ASC_CPP_ENABLE_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@ASC_CPP_ENABLE_CUDA@)
  find_dependency(CUDAToolkit)
endif()
if(_ASCCpp_needs_linalg AND @ASC_CPP_ENABLE_EIGEN@)
  find_dependency(Eigen3 3.3 NO_MODULE)
endif()
if(_ASCCpp_needs_linalg AND @ASC_CPP_ENABLE_MKL@)
  find_dependency(MKL CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ASCCppTargets.cmake")

set(ASCCpp_VERSION "@PROJECT_VERSION@")
foreach(_ASCCpp_component IN LISTS ASCCpp_FIND_COMPONENTS)
  if(NOT TARGET "ASC::${_ASCCpp_component}")
    set(ASCCpp_${_ASCCpp_component}_FOUND FALSE)
    set(ASCCpp_NOT_FOUND_MESSAGE
      "ASCCpp component '${_ASCCpp_component}' is missing its imported target."
    )
  endif()
endforeach()
check_required_components(ASCCpp)

unset(_ASCCpp_component)
unset(_ASCCpp_needs_linalg)
unset(_ASCCpp_requested)
unset(_ASCCpp_supported_components)
