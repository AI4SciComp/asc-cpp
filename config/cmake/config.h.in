// Build-specific asc-cpp feature configuration. This file is configured by
// CMake and consumed through <asc/core/config.h>.

#ifndef ASC_CONFIG_GENERATED_H_
#define ASC_CONFIG_GENERATED_H_

#define ASC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ASC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ASC_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ASC_VERSION_STRING "@PROJECT_VERSION@"

#cmakedefine ASC_DEBUG
#cmakedefine ASC_USE_EXCEPTION
#cmakedefine ASC_USE_SINGLE
#cmakedefine ASC_USE_DOUBLE
#cmakedefine ASC_USE_OPENMP
#cmakedefine ASC_USE_CUDA
#cmakedefine ASC_USE_EIGEN
#cmakedefine ASC_USE_MKL

#endif  // ASC_CONFIG_GENERATED_H_
