{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default developer build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "ASC_CPP_BUILD_TESTING": "ON",
        "ASC_CPP_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "strict",
      "inherits": "default",
      "displayName": "Warnings as errors",
      "binaryDir": "${sourceDir}/build/strict",
      "cacheVariables": {
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release library",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "ASC_CPP_BUILD_TESTING": "OFF",
        "ASC_CPP_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "default",
      "displayName": "Address and undefined-behavior sanitizers",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": {
        "ASC_CPP_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "openmp",
      "inherits": "default",
      "displayName": "OpenMP backend",
      "binaryDir": "${sourceDir}/build/openmp",
      "cacheVariables": {
        "ASC_CPP_ENABLE_OPENMP": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "strict", "configurePreset": "strict" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitizers", "configurePreset": "sanitizers" },
    { "name": "openmp", "configurePreset": "openmp" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "strict",
      "configurePreset": "strict",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "openmp",
      "configurePreset": "openmp",
      "output": { "outputOnFailure": true }
    }
  ]
}
