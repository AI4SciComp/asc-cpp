{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/asc-cpp-build/${presetName}",
      "cacheVariables": {
        "ASC_CPP_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Provider-free development / Debug",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "OFF",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Provider-free development / Release",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "OFF",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "test-debug",
      "displayName": "Provider-free tests / Debug static",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "ON",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "test-release",
      "displayName": "Provider-free tests / Release static",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "ON",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "install-test",
      "displayName": "Installed and relocated package tests",
      "inherits": "test-release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceParentDir}/asc-cpp-build/install-test/prefix with spaces"
      }
    },
    {
      "name": "test-shared",
      "displayName": "Provider-free tests / Debug shared",
      "inherits": "test-debug",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "test-release-shared",
      "displayName": "Provider-free tests / Release shared",
      "inherits": "test-release",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "test-asan-ubsan",
      "displayName": "Provider-free tests / Address and undefined sanitizers",
      "inherits": "test-debug",
      "cacheVariables": {
        "ASC_CPP_ENABLE_ADDRESS_SANITIZER": "ON",
        "ASC_CPP_ENABLE_UNDEFINED_SANITIZER": "ON"
      }
    },
    {
      "name": "test-lsan",
      "displayName": "Provider-free tests / LeakSanitizer",
      "inherits": "test-debug",
      "cacheVariables": {
        "ASC_CPP_ENABLE_LEAK_SANITIZER": "ON"
      }
    },
    {
      "name": "test-tsan",
      "displayName": "Provider-free concurrency tests / ThreadSanitizer",
      "inherits": "test-debug",
      "cacheVariables": {
        "ASC_CPP_ENABLE_THREAD_SANITIZER": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "Full Clang-Tidy analysis",
      "inherits": "dev-debug",
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy-18",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Strict API documentation",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_DOCUMENTATION": "ON",
        "ASC_CPP_BUILD_TESTING": "OFF",
        "ASC_CPP_INSTALL": "OFF",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "test-cuda",
      "displayName": "Experimental CUDA evidence / Release static",
      "inherits": "test-release",
      "cacheVariables": {
        "ASC_CPP_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "86"
      }
    },
    {
      "name": "test-cuda-shared",
      "displayName": "Experimental CUDA evidence / Release shared",
      "inherits": "test-cuda",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev-debug", "configurePreset": "dev-debug", "configuration": "Debug" },
    { "name": "dev-release", "configurePreset": "dev-release", "configuration": "Release" },
    { "name": "test-debug", "configurePreset": "test-debug", "configuration": "Debug" },
    { "name": "test-release", "configurePreset": "test-release", "configuration": "Release" },
    { "name": "install-test", "configurePreset": "install-test", "configuration": "Release" },
    { "name": "test-shared", "configurePreset": "test-shared", "configuration": "Debug" },
    { "name": "test-release-shared", "configurePreset": "test-release-shared", "configuration": "Release" },
    { "name": "test-asan-ubsan", "configurePreset": "test-asan-ubsan", "configuration": "Debug" },
    { "name": "test-lsan", "configurePreset": "test-lsan", "configuration": "Debug" },
    { "name": "test-tsan", "configurePreset": "test-tsan", "configuration": "Debug" },
    { "name": "tidy", "configurePreset": "tidy", "configuration": "Debug" },
    {
      "name": "docs",
      "configurePreset": "docs",
      "configuration": "Release",
      "targets": ["asc_cpp_docs_check"]
    },
    { "name": "test-cuda", "configurePreset": "test-cuda", "configuration": "Release" },
    { "name": "test-cuda-shared", "configurePreset": "test-cuda-shared", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "test-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-release",
      "configurePreset": "test-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "install-test",
      "configurePreset": "install-test",
      "configuration": "Release",
      "filter": { "include": { "label": "package" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-shared",
      "configurePreset": "test-shared",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-release-shared",
      "configurePreset": "test-release-shared",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-asan-ubsan",
      "configurePreset": "test-asan-ubsan",
      "configuration": "Debug",
      "filter": { "exclude": { "label": "package|consumer" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-lsan",
      "configurePreset": "test-lsan",
      "configuration": "Debug",
      "filter": { "exclude": { "label": "package|consumer" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-tsan",
      "configurePreset": "test-tsan",
      "configuration": "Debug",
      "filter": {
        "include": { "label": "concurrency" },
        "exclude": { "label": "package|consumer|benchmark" }
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-cuda",
      "configurePreset": "test-cuda",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-cuda-shared",
      "configurePreset": "test-cuda-shared",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
