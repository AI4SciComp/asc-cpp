{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev-debug",
      "displayName": "Milestone 8 hardening / Debug (CUDA disabled)",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "OFF",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Milestone 8 hardening / Release (CUDA disabled)",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "OFF",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "test-debug",
      "displayName": "Milestone 8 CPU-only tests / Debug",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "ON",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "test-release",
      "displayName": "Milestone 8 CPU-only tests / Release",
      "inherits": "base",
      "cacheVariables": {
        "ASC_CPP_BUILD_TESTING": "ON",
        "ASC_CPP_INSTALL": "ON",
        "ASC_CPP_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "install-test",
      "displayName": "Milestone 8 relocated CPU-only component package tests",
      "inherits": "test-release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install-test/prefix with spaces"
      }
    },
    {
      "name": "test-shared",
      "displayName": "Milestone 8 shared CPU-only tests",
      "inherits": "test-debug",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "test-asan-ubsan",
      "displayName": "Milestone 8 CPU ASan and UBSan tests",
      "inherits": "test-debug",
      "cacheVariables": {
        "ASC_CPP_ENABLE_ADDRESS_SANITIZER": "ON",
        "ASC_CPP_ENABLE_UNDEFINED_SANITIZER": "ON"
      }
    },
    {
      "name": "test-cuda",
      "displayName": "Milestone 8 CUDA runtime and parity tests",
      "inherits": "test-release",
      "cacheVariables": {
        "ASC_CPP_ENABLE_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "configuration": "Debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "configuration": "Release"
    },
    {
      "name": "test-debug",
      "configurePreset": "test-debug",
      "configuration": "Debug"
    },
    {
      "name": "test-release",
      "configurePreset": "test-release",
      "configuration": "Release"
    },
    {
      "name": "install-test",
      "configurePreset": "install-test",
      "configuration": "Release"
    },
    {
      "name": "test-shared",
      "configurePreset": "test-shared",
      "configuration": "Debug"
    },
    {
      "name": "test-asan-ubsan",
      "configurePreset": "test-asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "test-cuda",
      "configurePreset": "test-cuda",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "test-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-release",
      "configurePreset": "test-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "install-test",
      "configurePreset": "install-test",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "package"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-shared",
      "configurePreset": "test-shared",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-asan-ubsan",
      "configurePreset": "test-asan-ubsan",
      "configuration": "Debug",
      "filter": {
        "exclude": {
          "label": "package|consumer"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-cuda",
      "configurePreset": "test-cuda",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "milestone-6|milestone-7|milestone-8"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
