diff --git a/tests/dense_lapack/provider_metadata_test.cc b/tests/dense_lapack/provider_metadata_test.cc
new file mode 100644
index 0000000..f92a728
--- /dev/null
+++ b/tests/dense_lapack/provider_metadata_test.cc
@@ -0,0 +1,164 @@
+#include <array>
+#include <cstddef>
+#include <cstdio>
+#include <string_view>
+#include <thread>
+
+#include "../../src/dense/lapack/internal_provider_metadata_prototypes.h"
+#include "../../src/dense/lapack/internal_tridiagonal.h"
+#include "../dense/test_support.h"
+#include "asc/core/execution.h"
+#include "asc/core/status.h"
+#include "asc/dense/lapack/report.h"
+#include "asc/dense/lapack/types.h"
+#include "asc/dense/providers/lapack.h"
+#include "installed_lu/normal_return_guard.h"
+#include "provider_metadata_test_support.h"
+namespace {
+namespace support = asc_provider_metadata_test;
+namespace numerical = asc_provider_metadata_numerical;
+using numerical::Input;
+using numerical::Operation;
+using support::TestContext;
+template <Operation Op>
+numerical::Output<Op> Native(TestContext& test, Input input) {
+  if constexpr (Op == Operation::kVersion) {
+    std::array<lapack_int, 3> major{71, -19, 73};
+    std::array<lapack_int, 3> minor{71, -19, 73};
+    std::array<lapack_int, 3> patch{71, -19, 73};
+    LAPACK_ilaver(&major[1], &minor[1], &patch[1]);
+    for (const auto& field : {major, minor, patch}) {
+      ASC_DENSE_TEST_EQ(test, field[0], 71);
+      ASC_DENSE_TEST_EQ(test, field[2], 73);
+    }
+    return {major[1], minor[1], patch[1]};
+  } else if constexpr (Op == Operation::kCharacter) {
+    std::array<lapack_int, 3> code{71, static_cast<lapack_int>(input.code), 73};
+    const auto original = code;
+    std::array<char, 3> result{'Q', '?', 'R'};
+    ASC_LAPACK_chla_transtype(&result[1], 1, &code[1]);
+    ASC_DENSE_TEST_EQ(test, code, original);
+    ASC_DENSE_TEST_EQ(test, result[0], 'Q');
+    ASC_DENSE_TEST_EQ(test, result[2], 'R');
+    return result[1];
+  } else {
+    using Function = lapack_int(char*, std::size_t);
+    constexpr std::array<Function*, 4> kFunctions{
+        ASC_LAPACK_ilaprec, ASC_LAPACK_ilatrans, ASC_LAPACK_ilauplo,
+        ASC_LAPACK_iladiag};
+    std::array<char, 3> flag{'Q', input.flag, 'R'};
+    const auto before = flag;
+    const auto result = kFunctions[static_cast<std::size_t>(Op)](&flag[1], 1);
+    ASC_DENSE_TEST_EQ(test, flag, before);
+    return result;
+  }
+}
+template <Operation Op>
+void Case(TestContext& test, const asc::ReferenceLapackProvider& provider,
+          Input input, bool fidelity, bool audit) {
+  support::Guarded<Op> output;
+  output.values[1] = numerical::Initial<Op>(input);
+  const auto before = output.values;
+  const auto provider_before = support::Bytes(provider);
+  const bool admitted = numerical::Admitted<Op>(
+      input, provider.identity().integer_abi == asc::LapackIntegerAbi::kLp64);
+  asc::LapackReport report;
+  for (int repeat = 0; repeat < 2; ++repeat) {
+    const auto call = [&] {
+      return support::Execute<Op>(provider, input, output.values[1], report);
+    };
+    const auto status = audit ? support::WithoutAllocation(test, call) : call();
+    ASC_DENSE_TEST_EQ(
+        test, status.code(),
+        admitted ? asc::ErrorCode::kOk : asc::ErrorCode::kOverflow);
+    ASC_DENSE_TEST_EQ(test, report.called_provider, admitted);
+    ASC_DENSE_TEST_EQ(test, report.provider, provider.identity());
+    ASC_DENSE_TEST_EQ(test, std::string_view(report.routine.data()),
+                      numerical::Name<Op>());
+    ASC_DENSE_TEST_CHECK(test, !report.native_info.has_value());
+    ASC_DENSE_TEST_CHECK(test, !report.native_argument.has_value());
+    ASC_DENSE_TEST_CHECK(test, !report.diagnostic_index.has_value());
+    ASC_DENSE_TEST_CHECK(test, !report.factor_family.has_value());
+    if (admitted) {
+      ASC_DENSE_TEST_EQ(test, report.outcome, asc::LapackOutcome::kSuccess);
+      ASC_DENSE_TEST_EQ(test, report.output_validity,
+                        asc::LapackOutputValidity::kComplete);
+      const auto expected =
+          fidelity ? Native<Op>(test, input) : numerical::Expected<Op>(input);
+      ASC_DENSE_TEST_EQ(test, output.values[1], expected);
+    } else {
+      ASC_DENSE_TEST_EQ(test, report.outcome, asc::LapackOutcome::kNotRun);
+      ASC_DENSE_TEST_EQ(test, report.output_validity,
+                        asc::LapackOutputValidity::kUnchanged);
+      ASC_DENSE_TEST_EQ(test, output.values, before);
+    }
+    ASC_DENSE_TEST_EQ(test, output.values[0], before[0]);
+    ASC_DENSE_TEST_EQ(test, output.values[2], before[2]);
+    ASC_DENSE_TEST_EQ(test, support::Bytes(provider), provider_before);
+  }
+}
+template <Operation Op>
+void Concurrent(TestContext& test,
+                const asc::ReferenceLapackProvider& provider) {
+  std::array<std::thread, 4> threads;
+  std::array<int, 4> failures{};
+  for (std::size_t worker = 0; worker < threads.size(); ++worker) {
+    threads[worker] = std::thread([&, worker] {
+      TestContext local;
+      numerical::ForEach<Op>(
+          [&](Input input) { Case<Op>(local, provider, input, false, false); });
+      failures[worker] = local.Finish();
+    });
+  }
+  for (auto& thread : threads) {
+    thread.join();
+  }
+  for (int failure : failures) {
+    ASC_DENSE_TEST_EQ(test, failure, 0);
+  }
+}
+template <Operation Op>
+void Run(TestContext& test, std::string_view mode) {
+  const auto provider = support::Take(
+      asc::ReferenceLapackProvider::Create(asc::ExecutionContext::Serial()));
+  if (mode == "concurrency") {
+    Concurrent<Op>(test, provider);
+    return;
+  }
+  std::size_t count = 0;
+  numerical::ForEach<Op>([&](Input input) {
+    Case<Op>(test, provider, input, mode == "fidelity", true);
+    ++count;
+  });
+  std::printf("%zu provider metadata fixtures; first and reused outputs\n",
+              count);
+}
+}  // namespace
+int main(int argc, char** argv) {
+  const asc_lapack_test::NormalReturnGuard guard;
+  if (argc != 3) {
+    return 2;
+  }
+  const std::string_view operation(argv[1]);
+  const std::string_view mode(argv[2]);
+  if (mode != "mathematical" && mode != "fidelity" && mode != "concurrency") {
+    return 2;
+  }
+  TestContext test;
+  if (operation == "ilaprec") {
+    Run<Operation::kPrecision>(test, mode);
+  } else if (operation == "ilatrans") {
+    Run<Operation::kTranspose>(test, mode);
+  } else if (operation == "ilauplo") {
+    Run<Operation::kTriangle>(test, mode);
+  } else if (operation == "iladiag") {
+    Run<Operation::kDiagonal>(test, mode);
+  } else if (operation == "chla_transtype") {
+    Run<Operation::kCharacter>(test, mode);
+  } else if (operation == "ilaver") {
+    Run<Operation::kVersion>(test, mode);
+  } else {
+    return 2;
+  }
+  return test.Finish();
+}
diff --git a/tests/dense_lapack/provider_metadata_test_support.h b/tests/dense_lapack/provider_metadata_test_support.h
new file mode 100644
index 0000000..cb95cd5
--- /dev/null
+++ b/tests/dense_lapack/provider_metadata_test_support.h
@@ -0,0 +1,50 @@
+#ifndef ASC_TESTS_DENSE_LAPACK_PROVIDER_METADATA_TEST_SUPPORT_H_
+#define ASC_TESTS_DENSE_LAPACK_PROVIDER_METADATA_TEST_SUPPORT_H_
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <span>
+
+#include "asc/dense/lapack/report.h"
+#include "asc/dense/providers/lapack.h"
+#include "asc/dense/providers/lapack_provider_metadata.h"
+#include "installed_lu/provider_metadata_numerical.h"  // IWYU pragma: export
+#include "tridiagonal_test_support.h"                  // IWYU pragma: export
+namespace asc_provider_metadata_test {
+using asc_provider_metadata_numerical::Input;
+using asc_provider_metadata_numerical::Operation;
+using asc_provider_metadata_numerical::Output;
+using asc_tridiagonal_test::Take;
+using asc_tridiagonal_test::TestContext;
+using asc_tridiagonal_test::WithoutAllocation;
+template <typename T>
+auto Bytes(const T& object) {
+  std::array<std::byte, sizeof(T)> result{};
+  const auto bytes = std::as_bytes(std::span(&object, 1));
+  std::copy(bytes.begin(), bytes.end(), result.begin());
+  return result;
+}
+template <Operation Op>
+auto Execute(const asc::ReferenceLapackProvider& provider, Input input,
+             Output<Op>& result, asc::LapackReport& report) {
+  if constexpr (Op == Operation::kPrecision) {
+    return asc::Ilaprec(provider, input.flag, result, report);
+  } else if constexpr (Op == Operation::kTranspose) {
+    return asc::Ilatrans(provider, input.flag, result, report);
+  } else if constexpr (Op == Operation::kTriangle) {
+    return asc::Ilauplo(provider, input.flag, result, report);
+  } else if constexpr (Op == Operation::kDiagonal) {
+    return asc::Iladiag(provider, input.flag, result, report);
+  } else if constexpr (Op == Operation::kCharacter) {
+    return asc::ChlaTranstype(provider, input.code, result, report);
+  } else {
+    return asc::Ilaver(provider, result, report);
+  }
+}
+template <Operation Op>
+struct Guarded {
+  std::array<Output<Op>, 3> values{Output<Op>{71}, Output<Op>{},
+                                   Output<Op>{73}};
+};
+}  // namespace asc_provider_metadata_test
+#endif  // ASC_TESTS_DENSE_LAPACK_PROVIDER_METADATA_TEST_SUPPORT_H_
