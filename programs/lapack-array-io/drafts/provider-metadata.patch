diff --git a/include/asc/dense/providers/lapack_provider_metadata.h b/include/asc/dense/providers/lapack_provider_metadata.h
new file mode 100644
index 0000000..44bf271
--- /dev/null
+++ b/include/asc/dense/providers/lapack_provider_metadata.h
@@ -0,0 +1,117 @@
+#ifndef ASC_DENSE_PROVIDERS_LAPACK_PROVIDER_METADATA_H_
+#define ASC_DENSE_PROVIDERS_LAPACK_PROVIDER_METADATA_H_
+/** @file
+ * @brief Checked native option codes, transpose characters and LAPACK version.
+ *
+ * These scalar metadata operations preserve native sentinel results: -1 for
+ * an unrecognized character and 'X' for an unrecognized transpose code are
+ * complete values, not native INFO. Every character bit pattern is admitted.
+ * Alphabetic option letters are case insensitive in the selected provider.
+ * Outputs are live host objects, disjoint from provider/report metadata; their
+ * old values are not read. Metadata overlap rejects before report reset or
+ * numeric access. By-value inputs may originate in output objects.
+ *
+ * Each call stages its outputs and validates private input preservation and
+ * the operation's result domain before publication. An invalid native result
+ * returns kProvider with partial/unusable output validity and preserves caller
+ * outputs. In-domain results are not an accuracy or provenance certificate.
+ * There is no workspace, allocation, transfer, synchronization or native query.
+ * Native INFO, argument, diagnostic index and factor family remain absent.
+ * Floating-point controls remain unchanged. Concurrent calls keep mutable
+ * output and report state private.
+ */
+#include <array>
+
+#include "asc/core/status.h"
+#include "asc/core/types.h"
+#include "asc/dense/lapack/report.h"
+#include "asc/dense/providers/lapack.h"
+#include "asc/dense/providers/lapack_export.h"
+namespace asc {
+/** @brief Translates S/D/I/X or E to single/double/indigenous/extra precision.
+ * @param provider Explicit checked serial Reference provider.
+ * @param precision One character, including lower-case aliases; other values
+ * produce the native -1 sentinel.
+ * @param code Receives 211/212/213/214, respectively, or -1. A live host
+ * index_t.
+ * @param report Preserved on metadata alias; otherwise reset and records the
+ * actual native call and complete or unusable publication validity.
+ * @return Success after native code publication, including -1; kProvider for
+ * changed private character or result outside the documented set; or local
+ * metadata-overlap error. No output is published on error.
+ */
+ASC_DENSE_LAPACK_EXPORT Status Ilaprec(const ReferenceLapackProvider& provider,
+                                       char precision, index_t& code,
+                                       LapackReport& report);
+/** @brief Translates N/T/C to no transpose/transpose/conjugate transpose.
+ * @param provider Explicit checked serial Reference provider.
+ * @param transpose One character, including lower-case aliases; other values
+ * produce the native -1 sentinel.
+ * @param code Receives 111/112/113, respectively, or -1. A live host index_t.
+ * @param report Preserved on metadata alias; otherwise reset and records the
+ * actual native call and complete or unusable publication validity.
+ * @return Success after native code publication, including -1; kProvider for
+ * changed private character or result outside the documented set; or local
+ * metadata-overlap error. No output is published on error.
+ */
+ASC_DENSE_LAPACK_EXPORT Status Ilatrans(const ReferenceLapackProvider& provider,
+                                        char transpose, index_t& code,
+                                        LapackReport& report);
+/** @brief Translates U/L to upper/lower triangle.
+ * @param provider Explicit checked serial Reference provider.
+ * @param triangle One character, including lower-case aliases; other values
+ * produce the native -1 sentinel.
+ * @param code Receives 121/122, respectively, or -1. A live host index_t.
+ * @param report Preserved on metadata alias; otherwise reset and records the
+ * actual native call and complete or unusable publication validity.
+ * @return Success after native code publication, including -1; kProvider for
+ * changed private character or result outside the documented set; or local
+ * metadata-overlap error. No output is published on error.
+ */
+ASC_DENSE_LAPACK_EXPORT Status Ilauplo(const ReferenceLapackProvider& provider,
+                                       char triangle, index_t& code,
+                                       LapackReport& report);
+/** @brief Translates N/U to non-unit/unit diagonal.
+ * @param provider Explicit checked serial Reference provider.
+ * @param diagonal One character, including lower-case aliases; other values
+ * produce the native -1 sentinel.
+ * @param code Receives 131/132, respectively, or -1. A live host index_t.
+ * @param report Preserved on metadata alias; otherwise reset and records the
+ * actual native call and complete or unusable publication validity.
+ * @return Success after native code publication, including -1; kProvider for
+ * changed private character or result outside the documented set; or local
+ * metadata-overlap error. No output is published on error.
+ */
+ASC_DENSE_LAPACK_EXPORT Status Iladiag(const ReferenceLapackProvider& provider,
+                                       char diagonal, index_t& code,
+                                       LapackReport& report);
+/** @brief Translates native transpose codes to their single characters.
+ * @param provider Explicit checked serial Reference provider.
+ * @param code 111/112/113 maps to N/T/C; other represented integers map to X.
+ * Must fit the actual provider INTEGER; no narrowing is implied.
+ * @param transpose Live host char receiving the native character on success.
+ * @param report Preserved on metadata alias; otherwise reset and records native
+ * entry, absent INFO and publication validity.
+ * @return Success including X, local kOverflow for unrepresentable input,
+ * kProvider for changed private integer or a character outside N/T/C/X, or
+ * metadata-overlap error. All errors preserve the caller's output.
+ */
+ASC_DENSE_LAPACK_EXPORT Status
+ChlaTranstype(const ReferenceLapackProvider& provider, index_t code,
+              char& transpose, LapackReport& report);
+/** @brief Obtains the native LAPACK major, minor and patch version numbers.
+ * @param provider Explicit checked serial Reference provider.
+ * @param version Live host array receiving major/minor/patch in that order.
+ * All three values publish together; its old values are not read.
+ * @param report Preserved on metadata alias; otherwise reset and records native
+ * entry, absent INFO and publication validity.
+ * @return Success for three nonnegative native integers; kProvider for a
+ * negative or omitted staged output, or local metadata-overlap error. Errors
+ * preserve the entire array. Returned numbers describe the native routine and
+ * do not replace the provider's attested source/build identity.
+ */
+ASC_DENSE_LAPACK_EXPORT Status Ilaver(const ReferenceLapackProvider& provider,
+                                      std::array<index_t, 3>& version,
+                                      LapackReport& report);
+}  // namespace asc
+#endif  // ASC_DENSE_PROVIDERS_LAPACK_PROVIDER_METADATA_H_
diff --git a/src/dense/lapack/internal_provider_metadata_prototypes.h b/src/dense/lapack/internal_provider_metadata_prototypes.h
new file mode 100644
index 0000000..d91e617
--- /dev/null
+++ b/src/dense/lapack/internal_provider_metadata_prototypes.h
@@ -0,0 +1,21 @@
+#ifndef ASC_DENSE_LAPACK_INTERNAL_PROVIDER_METADATA_PROTOTYPES_H_
+#define ASC_DENSE_LAPACK_INTERNAL_PROVIDER_METADATA_PROTOTYPES_H_
+#include <cstddef>
+
+#include "internal_tridiagonal.h"
+// Actual GNU11 declarations. CHARACTER return uses leading result storage and
+// size_t length; scalar CHARACTER inputs have a trailing size_t length.
+#define ASC_LAPACK_ilaprec LAPACK_GLOBAL(ilaprec, ILAPREC)
+#define ASC_LAPACK_ilatrans LAPACK_GLOBAL(ilatrans, ILATRANS)
+#define ASC_LAPACK_ilauplo LAPACK_GLOBAL(ilauplo, ILAUPLO)
+#define ASC_LAPACK_iladiag LAPACK_GLOBAL(iladiag, ILADIAG)
+#define ASC_LAPACK_chla_transtype LAPACK_GLOBAL(chla_transtype, CHLA_TRANSTYPE)
+extern "C" {
+lapack_int ASC_LAPACK_ilaprec(char* input, std::size_t input_length);
+lapack_int ASC_LAPACK_ilatrans(char* input, std::size_t input_length);
+lapack_int ASC_LAPACK_ilauplo(char* input, std::size_t input_length);
+lapack_int ASC_LAPACK_iladiag(char* input, std::size_t input_length);
+void ASC_LAPACK_chla_transtype(char* result, std::size_t result_length,
+                               lapack_int* code);
+}
+#endif  // ASC_DENSE_LAPACK_INTERNAL_PROVIDER_METADATA_PROTOTYPES_H_
diff --git a/src/dense/lapack/reference_provider_metadata.cc b/src/dense/lapack/reference_provider_metadata.cc
new file mode 100644
index 0000000..6dffca0
--- /dev/null
+++ b/src/dense/lapack/reference_provider_metadata.cc
@@ -0,0 +1,128 @@
+#include <array>
+#include <cstddef>
+#include <limits>
+#include <string_view>
+
+#include "asc/core/status.h"
+#include "asc/core/types.h"
+#include "asc/dense/lapack/report.h"
+#include "asc/dense/providers/lapack.h"
+#include "asc/dense/providers/lapack_provider_metadata.h"
+#include "internal_provider_metadata_prototypes.h"
+#include "internal_tridiagonal.h"
+namespace asc {
+namespace {
+namespace checked = internal_tridiagonal;
+template <typename T>
+Status Begin(const ReferenceLapackProvider& provider, const T& output,
+             std::string_view routine, LapackReport& report) {
+  const std::array spans{checked::ObjectStorage(provider),
+                         checked::ObjectStorage(output),
+                         checked::ObjectStorage(report)};
+  const Status status = checked::Disjoint(spans);
+  if (!status.ok()) {
+    return status;
+  }
+  checked::StartReport(provider, routine, report);
+  return Status::Ok();
+}
+Status Defect(LapackReport& report) {
+  report.outcome = LapackOutcome::kPartialResult;
+  report.output_validity = LapackOutputValidity::kUnusable;
+  return Status(ErrorCode::kProvider);
+}
+template <std::size_t Operation>
+bool Allowed(lapack_int code) {
+  if (code == -1) {
+    return true;
+  }
+  if constexpr (Operation == 0) {
+    return code >= 211 && code <= 214;
+  } else if constexpr (Operation == 1) {
+    return code >= 111 && code <= 113;
+  } else if constexpr (Operation == 2) {
+    return code == 121 || code == 122;
+  } else {
+    return code == 131 || code == 132;
+  }
+}
+template <std::size_t Operation>
+Status Code(const ReferenceLapackProvider& provider, char flag, index_t& code,
+            LapackReport& report) {
+  constexpr std::array<std::string_view, 4> kNames{"ilaprec", "ilatrans",
+                                                   "ilauplo", "iladiag"};
+  const Status status = Begin(provider, code, kNames[Operation], report);
+  if (!status.ok()) {
+    return status;
+  }
+  using Function = lapack_int(char*, std::size_t);
+  constexpr std::array<Function*, 4> kFunctions{
+      ASC_LAPACK_ilaprec, ASC_LAPACK_ilatrans, ASC_LAPACK_ilauplo,
+      ASC_LAPACK_iladiag};
+  char input = flag;
+  report.called_provider = true;
+  const lapack_int result = kFunctions[Operation](&input, 1);
+  if (input != flag || !Allowed<Operation>(result)) {
+    return Defect(report);
+  }
+  code = static_cast<index_t>(result);
+  return checked::Complete(report);
+}
+}  // namespace
+Status Ilaprec(const ReferenceLapackProvider& provider, char precision,
+               index_t& code, LapackReport& report) {
+  return Code<0>(provider, precision, code, report);
+}
+Status Ilatrans(const ReferenceLapackProvider& provider, char transpose,
+                index_t& code, LapackReport& report) {
+  return Code<1>(provider, transpose, code, report);
+}
+Status Ilauplo(const ReferenceLapackProvider& provider, char triangle,
+               index_t& code, LapackReport& report) {
+  return Code<2>(provider, triangle, code, report);
+}
+Status Iladiag(const ReferenceLapackProvider& provider, char diagonal,
+               index_t& code, LapackReport& report) {
+  return Code<3>(provider, diagonal, code, report);
+}
+Status ChlaTranstype(const ReferenceLapackProvider& provider, index_t code,
+                     char& transpose, LapackReport& report) {
+  const Status status = Begin(provider, transpose, "chla_transtype", report);
+  if (!status.ok()) {
+    return status;
+  }
+  if (code < std::numeric_limits<lapack_int>::min() ||
+      code > std::numeric_limits<lapack_int>::max()) {
+    return Status(ErrorCode::kOverflow);
+  }
+  lapack_int input = static_cast<lapack_int>(code);
+  char result = '\0';
+  report.called_provider = true;
+  ASC_LAPACK_chla_transtype(&result, 1, &input);
+  if (input != code ||
+      (result != 'N' && result != 'T' && result != 'C' && result != 'X')) {
+    return Defect(report);
+  }
+  transpose = result;
+  return checked::Complete(report);
+}
+Status Ilaver(const ReferenceLapackProvider& provider,
+              std::array<index_t, 3>& version, LapackReport& report) {
+  const Status status = Begin(provider, version, "ilaver", report);
+  if (!status.ok()) {
+    return status;
+  }
+  std::array<lapack_int, 3> result{-1, -1, -1};
+  report.called_provider = true;
+  LAPACK_ilaver(&result[0], &result[1], &result[2]);
+  for (auto field : result) {
+    if (field < 0) {
+      return Defect(report);
+    }
+  }
+  for (std::size_t i = 0; i < version.size(); ++i) {
+    version[i] = static_cast<index_t>(result[i]);
+  }
+  return checked::Complete(report);
+}
+}  // namespace asc
diff --git a/tests/dense_lapack/installed_lu/provider_metadata_numerical.h b/tests/dense_lapack/installed_lu/provider_metadata_numerical.h
new file mode 100644
index 0000000..abe8dfb
--- /dev/null
+++ b/tests/dense_lapack/installed_lu/provider_metadata_numerical.h
@@ -0,0 +1,157 @@
+#ifndef ASC_TESTS_DENSE_LAPACK_INSTALLED_LU_PROVIDER_METADATA_NUMERICAL_H_
+#define ASC_TESTS_DENSE_LAPACK_INSTALLED_LU_PROVIDER_METADATA_NUMERICAL_H_
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <limits>
+#include <string_view>
+#include <type_traits>
+namespace asc_provider_metadata_numerical {
+enum class Operation : std::uint8_t {
+  kPrecision,
+  kTranspose,
+  kTriangle,
+  kDiagonal,
+  kCharacter,
+  kVersion
+};
+struct Input {
+  char flag = 'N';
+  std::int64_t code = 0;
+};
+template <Operation Op>
+using Output = std::conditional_t<
+    Op == Operation::kCharacter, char,
+    std::conditional_t<Op == Operation::kVersion, std::array<std::int64_t, 3>,
+                       std::int64_t>>;
+template <Operation Op>
+constexpr std::string_view Name() {
+  constexpr std::array<std::string_view, 6> kNames{
+      "ilaprec", "ilatrans", "ilauplo", "iladiag", "chla_transtype", "ilaver"};
+  return kNames[static_cast<unsigned int>(Op)];
+}
+inline std::int64_t CodeExpected(Operation operation, char c) {
+  switch (operation) {
+    case Operation::kPrecision:
+      switch (c) {
+        case 'S':
+        case 's':
+          return 211;
+        case 'D':
+        case 'd':
+          return 212;
+        case 'I':
+        case 'i':
+          return 213;
+        case 'X':
+        case 'x':
+        case 'E':
+        case 'e':
+          return 214;
+        default:
+          return -1;
+      }
+    case Operation::kTranspose:
+      switch (c) {
+        case 'N':
+        case 'n':
+          return 111;
+        case 'T':
+        case 't':
+          return 112;
+        case 'C':
+        case 'c':
+          return 113;
+        default:
+          return -1;
+      }
+    case Operation::kTriangle:
+      switch (c) {
+        case 'U':
+        case 'u':
+          return 121;
+        case 'L':
+        case 'l':
+          return 122;
+        default:
+          return -1;
+      }
+    case Operation::kDiagonal:
+      switch (c) {
+        case 'N':
+        case 'n':
+          return 131;
+        case 'U':
+        case 'u':
+          return 132;
+        default:
+          return -1;
+      }
+    case Operation::kCharacter:
+    case Operation::kVersion:
+      return -1;
+  }
+  return -1;
+}
+template <Operation Op>
+Output<Op> Expected(Input input) {
+  if constexpr (Op == Operation::kVersion) {
+    return {3, 12, 0};
+  } else if constexpr (Op == Operation::kCharacter) {
+    switch (input.code) {
+      case 111:
+        return 'N';
+      case 112:
+        return 'T';
+      case 113:
+        return 'C';
+      default:
+        return 'X';
+    }
+  } else {
+    return CodeExpected(Op, input.flag);
+  }
+}
+template <Operation Op>
+bool Admitted(Input input, bool lp64) {
+  if constexpr (Op == Operation::kCharacter) {
+    return !lp64 || (input.code >= std::numeric_limits<std::int32_t>::min() &&
+                     input.code <= std::numeric_limits<std::int32_t>::max());
+  } else {
+    return true;
+  }
+}
+template <Operation Op>
+Output<Op> Initial(Input input) {
+  if constexpr (Op == Operation::kCharacter) {
+    return '?';
+  } else if constexpr (Op == Operation::kVersion) {
+    return {input.code, input.code, input.code};
+  } else {
+    return -19;
+  }
+}
+template <Operation Op, typename Function>
+void ForEach(Function function) {
+  if constexpr (Op == Operation::kVersion) {
+    for (std::int64_t initial :
+         {std::numeric_limits<std::int64_t>::min(), std::int64_t{-19},
+          std::int64_t{0}, std::numeric_limits<std::int64_t>::max()}) {
+      function(Input{'N', initial});
+    }
+  } else if constexpr (Op == Operation::kCharacter) {
+    for (std::int64_t code : std::array<std::int64_t, 14>{
+             std::numeric_limits<std::int64_t>::min(), -1, 0, 1, 110, 111, 112,
+             113, 114, 211, 214, std::numeric_limits<std::int64_t>::max(),
+             std::numeric_limits<std::int32_t>::min(),
+             std::numeric_limits<std::int32_t>::max()}) {
+      function(Input{'N', code});
+    }
+  } else {
+    for (unsigned int byte = 0; byte < 256; ++byte) {
+      function(Input{std::bit_cast<char>(static_cast<unsigned char>(byte)), 0});
+    }
+  }
+}
+}  // namespace asc_provider_metadata_numerical
+#endif  // ASC_TESTS_DENSE_LAPACK_INSTALLED_LU_PROVIDER_METADATA_NUMERICAL_H_
diff --git a/tests/dense_lapack/provider_metadata_abi_probe.cc b/tests/dense_lapack/provider_metadata_abi_probe.cc
new file mode 100644
index 0000000..7a1827b
--- /dev/null
+++ b/tests/dense_lapack/provider_metadata_abi_probe.cc
@@ -0,0 +1,198 @@
+#include <array>
+#include <bit>
+#include <climits>
+#include <cstddef>
+#include <cstdio>
+#include <limits>
+#include <type_traits>
+
+#include "../../src/dense/lapack/internal_provider_metadata_prototypes.h"
+#include "../../src/dense/lapack/internal_tridiagonal.h"
+#include "installed_lu/normal_return_guard.h"
+#if defined(ASC_ILAPREC_HEADER)
+#define ilaprec_ emitted_ilaprec
+#include ASC_ILAPREC_HEADER
+#undef ilaprec_
+static_assert(
+    std::is_same_v<decltype(ASC_LAPACK_ilaprec), decltype(emitted_ilaprec)>);
+#define ilatrans_ emitted_ilatrans
+#include ASC_ILATRANS_HEADER
+#undef ilatrans_
+static_assert(
+    std::is_same_v<decltype(ASC_LAPACK_ilatrans), decltype(emitted_ilatrans)>);
+#define ilauplo_ emitted_ilauplo
+#include ASC_ILAUPLO_HEADER
+#undef ilauplo_
+static_assert(
+    std::is_same_v<decltype(ASC_LAPACK_ilauplo), decltype(emitted_ilauplo)>);
+#define iladiag_ emitted_iladiag
+#include ASC_ILADIAG_HEADER
+#undef iladiag_
+static_assert(
+    std::is_same_v<decltype(ASC_LAPACK_iladiag), decltype(emitted_iladiag)>);
+#define chla_transtype_ emitted_chla_transtype
+#include ASC_CHLA_TRANSTYPE_HEADER
+#undef chla_transtype_
+static_assert(std::is_same_v<decltype(ASC_LAPACK_chla_transtype),
+                             decltype(emitted_chla_transtype)>);
+#define ilaver_ emitted_ilaver
+#include ASC_ILAVER_HEADER
+#undef ilaver_
+static_assert(
+    std::is_same_v<decltype(LAPACK_ilaver), decltype(emitted_ilaver)>);
+#endif
+using CodeFunction = lapack_int(char*, std::size_t);
+static_assert(CHAR_BIT == 8 && 'Z' == 90 && sizeof(std::size_t) == 8);
+struct Counts {
+  int cases = 0;
+  int failures = 0;
+  int guards = 0;
+};
+int Expected(int operation, unsigned char c) {
+  switch (operation) {
+    case 0:
+      switch (c) {
+        case 'S':
+        case 's':
+          return 211;
+        case 'D':
+        case 'd':
+          return 212;
+        case 'I':
+        case 'i':
+          return 213;
+        case 'X':
+        case 'x':
+        case 'E':
+        case 'e':
+          return 214;
+        default:
+          return -1;
+      }
+    case 1:
+      switch (c) {
+        case 'N':
+        case 'n':
+          return 111;
+        case 'T':
+        case 't':
+          return 112;
+        case 'C':
+        case 'c':
+          return 113;
+        default:
+          return -1;
+      }
+    case 2:
+      switch (c) {
+        case 'U':
+        case 'u':
+          return 121;
+        case 'L':
+        case 'l':
+          return 122;
+        default:
+          return -1;
+      }
+    default:
+      switch (c) {
+        case 'N':
+        case 'n':
+          return 131;
+        case 'U':
+        case 'u':
+          return 132;
+        default:
+          return -1;
+      }
+  }
+}
+void Codes(Counts& count) {
+  const std::array<CodeFunction*, 4> functions{
+      ASC_LAPACK_ilaprec, ASC_LAPACK_ilatrans, ASC_LAPACK_ilauplo,
+      ASC_LAPACK_iladiag};
+  for (int operation = 0; operation < 4; ++operation) {
+    for (unsigned int byte = 0; byte < 256; ++byte) {
+      const auto bits = static_cast<unsigned char>(byte);
+      std::array<char, 3> flag{'Q', std::bit_cast<char>(bits), 'R'};
+      const auto original = flag;
+      for (int repeat = 0; repeat < 2; ++repeat) {
+        const lapack_int result =
+            functions[static_cast<std::size_t>(operation)](&flag[1], 1);
+        ++count.cases;
+        count.failures += result != Expected(operation, bits);
+        count.guards += flag != original;
+      }
+    }
+  }
+}
+void Characters(Counts& count) {
+  const std::array<lapack_int, 12> values{
+      std::numeric_limits<lapack_int>::min(),
+      -1,
+      0,
+      1,
+      110,
+      111,
+      112,
+      113,
+      114,
+      211,
+      214,
+      std::numeric_limits<lapack_int>::max()};
+  for (auto value : values) {
+    std::array<lapack_int, 3> input{71, value, 73};
+    const auto before = input;
+    char expected = 'X';
+    if (value == 111) {
+      expected = 'N';
+    } else if (value == 112) {
+      expected = 'T';
+    } else if (value == 113) {
+      expected = 'C';
+    }
+    for (int repeat = 0; repeat < 2; ++repeat) {
+      std::array<char, 3> result{'Q', '?', 'R'};
+      ASC_LAPACK_chla_transtype(&result[1], 1, &input[1]);
+      ++count.cases;
+      count.failures += result[1] != expected;
+      count.guards += input != before || result[0] != 'Q' || result[2] != 'R';
+    }
+  }
+}
+void Version(Counts& count) {
+  for (lapack_int initial :
+       {std::numeric_limits<lapack_int>::min(), lapack_int{-19}, lapack_int{0},
+        std::numeric_limits<lapack_int>::max()}) {
+    std::array<lapack_int, 3> major{71, initial, 73};
+    std::array<lapack_int, 3> minor{71, initial, 73};
+    std::array<lapack_int, 3> patch{71, initial, 73};
+    for (int repeat = 0; repeat < 2; ++repeat) {
+      LAPACK_ilaver(&major[1], &minor[1], &patch[1]);
+      ++count.cases;
+      count.failures += major[1] != 3 || minor[1] != 12 || patch[1] != 0;
+      count.guards += major[0] != 71 || major[2] != 73 || minor[0] != 71 ||
+                      minor[2] != 73 || patch[0] != 71 || patch[2] != 73;
+    }
+  }
+}
+int main() {
+  const asc_lapack_test::NormalReturnGuard guard;
+  Counts codes;
+  Counts characters;
+  Counts version;
+  Codes(codes);
+  Characters(characters);
+  Version(version);
+  std::printf(
+      "codes=%d failures=%d guards=%d; characters=%d failures=%d guards=%d; "
+      "version=%d failures=%d guards=%d; integer_bytes=%zu\n",
+      codes.cases, codes.failures, codes.guards, characters.cases,
+      characters.failures, characters.guards, version.cases, version.failures,
+      version.guards, sizeof(lapack_int));
+  return codes.failures + codes.guards + characters.failures +
+                     characters.guards + version.failures + version.guards !=
+                 0
+             ? 1
+             : 0;
+}
diff --git a/tests/dense_lapack/provider_metadata_faults.cc b/tests/dense_lapack/provider_metadata_faults.cc
