index 0000000..7866449
--- /dev/null
+++ b/tests/dense_lapack/provider_metadata_faults.cc
@@ -0,0 +1,149 @@
+#include "provider_metadata_faults.h"
+
+#include <array>
+#include <cstddef>
+#include <type_traits>
+
+#include "../../src/dense/lapack/internal_provider_metadata_prototypes.h"
+#include "../../src/dense/lapack/internal_tridiagonal.h"
+#include "installed_lu/provider_metadata_numerical.h"
+namespace asc_provider_metadata_fault {
+namespace {
+namespace numerical = asc_provider_metadata_numerical;
+thread_local Mode g_mode = Mode::kPass;
+thread_local std::size_t g_calls = 0;
+thread_local std::size_t g_unexpected = 0;
+template <numerical::Operation Op, typename Function>
+lapack_int Code(Function real, char* flag, std::size_t length) {
+  ++g_calls;
+  std::array<char, 3> input{'Q', *flag, 'R'};
+  const auto before = input;
+  lapack_int result = real(&input[1], 1);
+  if (length != 1 || input != before ||
+      result != numerical::Expected<Op>({*flag, 0})) {
+    ++g_unexpected;
+  }
+  switch (g_mode) {
+    case Mode::kChangeInput:
+      *flag = '?';
+      break;
+    case Mode::kInvalidLow:
+      result = -2;
+      break;
+    case Mode::kInvalidHigh:
+      result = 999;
+      break;
+    case Mode::kWrongInDomain:
+      result = -1;
+      break;
+    default:
+      break;
+  }
+  return result;
+}
+template <typename Function>
+void Character(Function real, char* output, std::size_t length,
+               lapack_int* code) {
+  ++g_calls;
+  std::array<char, 3> result{'Q', '?', 'R'};
+  std::array<lapack_int, 3> input{71, *code, 73};
+  const auto before = input;
+  real(&result[1], 1, &input[1]);
+  if (length != 1 || input != before || result[0] != 'Q' || result[2] != 'R' ||
+      result[1] !=
+          numerical::Expected<numerical::Operation::kCharacter>({'N', *code})) {
+    ++g_unexpected;
+  }
+  if (g_mode != Mode::kOmit0) {
+    *output = result[1];
+  }
+  if (g_mode == Mode::kChangeInput) {
+    *code = 0;
+  } else if (g_mode == Mode::kInvalidLow) {
+    *output = '?';
+  } else if (g_mode == Mode::kWrongInDomain) {
+    *output = 'X';
+  }
+}
+std::size_t Field(Mode first) {
+  const auto value = static_cast<unsigned int>(g_mode);
+  const auto start = static_cast<unsigned int>(first);
+  return value >= start && value < start + 3 ? value - start : 3;
+}
+template <typename Function>
+void Version(Function real, lapack_int* major, lapack_int* minor,
+             lapack_int* patch) {
+  ++g_calls;
+  std::array<std::array<lapack_int, 3>, 3> result{};
+  for (auto& field : result) {
+    field = {71, -19, 73};
+  }
+  real(&result[0][1], &result[1][1], &result[2][1]);
+  const std::array<lapack_int, 3> expected{3, 12, 0};
+  const std::array<lapack_int*, 3> output{major, minor, patch};
+  for (std::size_t i = 0; i < result.size(); ++i) {
+    if (result[i][0] != 71 || result[i][2] != 73 ||
+        result[i][1] != expected[i]) {
+      ++g_unexpected;
+    }
+    if (i != Field(Mode::kOmit0)) {
+      *output[i] = result[i][1];
+    }
+    if (i == Field(Mode::kNegative0)) {
+      *output[i] = -2;
+    }
+    if (g_mode == Mode::kWrongInDomain) {
+      *output[i] = 1;
+    }
+  }
+}
+}  // namespace
+void Reset(Mode mode) {
+  g_mode = mode;
+  g_calls = 0;
+  g_unexpected = 0;
+}
+std::size_t Calls() { return g_calls; }
+std::size_t UnexpectedNativeResults() { return g_unexpected; }
+// NOLINTBEGIN(bugprone-reserved-identifier)
+extern "C" decltype(ASC_LAPACK_ilaprec) __real_ilaprec_;
+extern "C" lapack_int __wrap_ilaprec_(char* input, std::size_t length) {
+  return Code<numerical::Operation::kPrecision>(__real_ilaprec_, input, length);
+}
+static_assert(
+    std::is_same_v<decltype(__wrap_ilaprec_), decltype(ASC_LAPACK_ilaprec)>);
+extern "C" decltype(ASC_LAPACK_ilatrans) __real_ilatrans_;
+extern "C" lapack_int __wrap_ilatrans_(char* input, std::size_t length) {
+  return Code<numerical::Operation::kTranspose>(__real_ilatrans_, input,
+                                                length);
+}
+static_assert(
+    std::is_same_v<decltype(__wrap_ilatrans_), decltype(ASC_LAPACK_ilatrans)>);
+extern "C" decltype(ASC_LAPACK_ilauplo) __real_ilauplo_;
+extern "C" lapack_int __wrap_ilauplo_(char* input, std::size_t length) {
+  return Code<numerical::Operation::kTriangle>(__real_ilauplo_, input, length);
+}
+static_assert(
+    std::is_same_v<decltype(__wrap_ilauplo_), decltype(ASC_LAPACK_ilauplo)>);
+extern "C" decltype(ASC_LAPACK_iladiag) __real_iladiag_;
+extern "C" lapack_int __wrap_iladiag_(char* input, std::size_t length) {
+  return Code<numerical::Operation::kDiagonal>(__real_iladiag_, input, length);
+}
+static_assert(
+    std::is_same_v<decltype(__wrap_iladiag_), decltype(ASC_LAPACK_iladiag)>);
+extern "C" decltype(ASC_LAPACK_chla_transtype) __real_chla_transtype_;
+extern "C" void __wrap_chla_transtype_(char* output, std::size_t length,
+                                       lapack_int* code) {
+  Character(__real_chla_transtype_, output, length, code);
+}
+static_assert(std::is_same_v<decltype(__wrap_chla_transtype_),
+                             decltype(ASC_LAPACK_chla_transtype)>);
+extern "C" decltype(LAPACK_ilaver) __real_ilaver_;
+extern "C" void __wrap_ilaver_(lapack_int* major, lapack_int* minor,
+                               lapack_int* patch) {
+  Version(__real_ilaver_, major, minor, patch);
+}
+static_assert(
+    std::is_same_v<decltype(__wrap_ilaver_), decltype(LAPACK_ilaver)>);
+// NOLINTEND(bugprone-reserved-identifier)
+}  // namespace asc_provider_metadata_fault
